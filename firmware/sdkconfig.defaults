# smaller bootloader (it only has 0x6000 bytes before the partition table)
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# --- target / flash / partitions ---------------------------------------
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# --- CPU / FreeRTOS -----------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- PSRAM (8 MB, quad) -------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# Needed for the extram_bss linker scheme: the decoder store (~93 KB .bss) is
# moved to PSRAM by main/linker.lf. (IDF itself then also puts the .bss of the
# Wi-Fi/lwip libs into PSRAM.)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# --- Wi-Fi: receive only, trim memory ------------------------------------
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=24
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# --- console / log / panic ----------------------------------------------
# Primary console: UART0 (GPIO11 TX, GPIO12 RX). Secondary: USB-Serial-JTAG
# (output only, non-blocking, drops when no host listens), so that logs and
# *panic dumps* are readable over the USB-C port (ESP Web Tools / browser
# console) without a USB-UART adapter. ROM/early boot output goes to both
# anyway. While the binary SLIP output on the same port is enabled
# (settings usb_out), main.c reroutes runtime logs to UART0 only so the SLIP
# stream stays clean (see log_vprintf in main.c). Panic dumps still go to USB.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Panic: print registers + backtrace, then reboot (also the default; explicit so
# it is not changed by accident). EH_FRAME makes the firmware print the
# backtrace itself (works with any serial terminal, bigger flash image).
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_USE_EH_FRAME=y

# --- FAT on SD card: long file names for its_0001.pcap ------------------
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# --- LVGL 8.4 -------------------------------------------------------------
CONFIG_LV_COLOR_DEPTH_16=y
# the ILI9488 driver expects byte-swapped RGB565 (it converts to RGB666)
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
# TTF with Latin-1 (umlauts) rendered at runtime, see main/fonts
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_LOG=n
